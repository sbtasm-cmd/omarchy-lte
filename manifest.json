{
  "schemaVersion": 1,
  "id": "xmm7360.lte",
  "name": "LTE",
  "version": "0.2.0",
  "author": "Nohdan S.",
  "license": "GPL-2.0-or-later",
  "description": "Cellular modem status, LTE signal, and a mobile data switch in the Omarchy bar (ModemManager + NetworkManager).",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "LTE",
    "description": "Mobile network status, operator, LTE signal (RSRP/RSRQ/SNR), and a mobile data toggle.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 10,
      "hideWithoutModem": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 3,
        "max": 300,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "hideWithoutModem",
        "type": "boolean",
        "label": "Hide when no modem is present",
        "defaultValue": true
      }
    ]
  }
}
