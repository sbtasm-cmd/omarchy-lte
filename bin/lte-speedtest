#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Measure the mobile link speed for one direction and print Mbps once a second.
# Same method as omarchy-network-speedtest (parallel fast.com transfers, rate
# from interface byte counters), but all traffic is forced through the modem
# interface, so the result is the mobile link even while Wi-Fi is the default
# route.
#
# Usage: lte-speedtest <down|up> <interface>

set -e

direction="${1:-}"
iface="${2:-}"
parallel=8
url_count=3

case "$direction" in
  down | up) ;;
  *)
    echo "Usage: lte-speedtest <down|up> <interface>" >&2
    exit 2
    ;;
esac

if [[ -z $iface || ! -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
  echo "Mobile interface is not up" >&2
  exit 1
fi

for cmd in curl jq; do
  command -v "$cmd" >/dev/null || { echo "$cmd is required" >&2; exit 1; }
done

format_mbps() {
  awk -v value="$1" 'BEGIN {
    if (value <= 0) print "0.0"
    else if (value < 10) printf "%.1f\n", value
    else printf "%.0f\n", value
  }'
}

fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
fast_api_url="https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count"

fast_urls=$(curl -fsS --interface "$iface" --max-time 15 "$fast_api_url" 2>/dev/null | jq -r '.targets[]?.url // empty')

if [[ -z $fast_urls ]]; then
  echo "Failed to reach the speed test service over $iface" >&2
  exit 1
fi

traffic_pids=()

cleanup() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
  done
  for pid in "${traffic_pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT

traffic_worker() {
  local urls=("$@")
  local count=${#urls[@]}
  local idx=$RANDOM url
  while true; do
    url=${urls[$((idx % count))]}
    if [[ $direction == "down" ]]; then
      curl -fsS --interface "$iface" -o /dev/null "$url" 2>/dev/null || return
    else
      dd if=/dev/zero bs=1M count=16 2>/dev/null |
        curl -fsS --interface "$iface" -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || return
    fi
    idx=$((idx + 1))
  done
}

for (( i = 0; i < parallel; i++ )); do
  traffic_worker $fast_urls &
  traffic_pids+=("$!")
done

stat_file=/sys/class/net/$iface/statistics/$([[ $direction == down ]] && echo rx_bytes || echo tx_bytes)
before=$(cat "$stat_file")

any_alive() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

while any_alive; do
  sleep 1
  after=$(cat "$stat_file")
  format_mbps "$(awk -v b="$before" -v a="$after" 'BEGIN { print (a < b) ? 0 : (a - b) * 8 / 1000000 }')"
  before=$after
done
