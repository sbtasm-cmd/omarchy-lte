#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Share the mobile connection over Wi-Fi (NetworkManager access point).

  lte-hotspot status                print JSON: configured, active, ssid, password, clients, iface
  lte-hotspot defaults              print JSON with a suggested SSID and a random password
  lte-hotspot configure SSID PASS   create/update the access point profile
  lte-hotspot on                    open the firewall once (pkexec), switch mobile data on, start it
  lte-hotspot off                   stop it (NetworkManager reconnects the normal Wi-Fi)

The Wi-Fi card works as the access point, so its normal Wi-Fi connection drops
while sharing. The password lives in the NetworkManager profile.
"""
import json
import os
import secrets
import shutil
import socket
import string
import subprocess
import sys

CONN = "lte-hotspot"
HERE = os.path.dirname(os.path.abspath(__file__))
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omarchy-lte")
FIREWALL_FLAG = os.path.join(STATE_DIR, "hotspot-firewall-ok")


def run(*cmd, timeout=60):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def out(obj, ok=True):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(0 if ok else 1)


def wifi_iface():
    _, stdout, _ = run("nmcli", "-t", "-f", "DEVICE,TYPE", "device")
    for line in stdout.splitlines():
        dev, _, typ = line.rpartition(":")
        if typ == "wifi":
            return dev
    return ""


def modem_iface():
    """IP interface of the active mobile connection (the gsm device itself is a control port)."""
    _, stdout, _ = run("nmcli", "-t", "-f", "TYPE,DEVICE", "connection", "show", "--active")
    for line in stdout.splitlines():
        typ, _, dev = line.partition(":")
        if typ == "gsm":
            code, ip_iface, _ = run("nmcli", "-g", "GENERAL.IP-IFACE", "device", "show", dev)
            if code == 0 and ip_iface:
                return ip_iface
    return "wwan0"


def mobile_data_active():
    _, stdout, _ = run("nmcli", "-t", "-f", "TYPE", "connection", "show", "--active")
    return "gsm" in stdout.splitlines()


def configured():
    _, stdout, _ = run("nmcli", "-t", "-f", "NAME", "connection", "show")
    return CONN in stdout.splitlines()


def status():
    iface = wifi_iface()
    st = {"configured": configured(), "active": False, "ssid": "", "password": "", "clients": 0, "iface": iface}
    if st["configured"]:
        code, stdout, _ = run("nmcli", "-s", "-g", "802-11-wireless.ssid,802-11-wireless-security.psk",
                              "connection", "show", "id", CONN)
        lines = stdout.splitlines() if code == 0 else []
        st["ssid"] = lines[0] if lines else ""
        st["password"] = lines[1] if len(lines) > 1 else ""
        _, stdout, _ = run("nmcli", "-t", "-f", "NAME", "connection", "show", "--active")
        st["active"] = CONN in stdout.splitlines()
    if st["active"] and iface:
        code, stdout, _ = run("iw", "dev", iface, "station", "dump")
        if code == 0:
            st["clients"] = sum(1 for l in stdout.splitlines() if l.startswith("Station "))
    return st


def defaults():
    alphabet = string.ascii_letters + string.digits
    return {"ssid": socket.gethostname().split(".")[0] + "-LTE",
            "password": "".join(secrets.choice(alphabet) for _ in range(12))}


def configure(ssid, password):
    if not 1 <= len(ssid.encode()) <= 32:
        return "The network name must be 1-32 bytes"
    if not 8 <= len(password) <= 63:
        return "The password must be 8-63 characters"
    iface = wifi_iface()
    if not iface:
        return "No Wi-Fi device"
    settings = [
        "connection.autoconnect", "no",
        "connection.interface-name", iface,
        "802-11-wireless.mode", "ap",
        "802-11-wireless.band", "bg",           # Intel cards often refuse AP on 5 GHz
        "802-11-wireless.ssid", ssid,
        "802-11-wireless-security.key-mgmt", "wpa-psk",
        "802-11-wireless-security.proto", "rsn",
        "802-11-wireless-security.pairwise", "ccmp",
        "802-11-wireless-security.group", "ccmp",
        "802-11-wireless-security.psk", password,
        "ipv4.method", "shared",
        "ipv6.method", "ignore",
    ]
    if configured():
        code, _, err = run("nmcli", "connection", "modify", "id", CONN, *settings)
    else:
        code, _, err = run("nmcli", "connection", "add", "type", "wifi", "con-name", CONN, "ifname", iface,
                           "ssid", ssid, *settings)
    return None if code == 0 else (err or "Couldn't save the hotspot profile")


def ensure_firewall(iface):
    """ufw drops forwarded traffic by default; open DHCP/DNS on the Wi-Fi side and
    allow routing Wi-Fi -> modem. Done once, through pkexec (polkit password dialog)."""
    if os.path.exists(FIREWALL_FLAG):
        return None
    if not shutil.which("ufw") or run("systemctl", "is-active", "ufw")[1] != "active":
        os.makedirs(STATE_DIR, exist_ok=True)
        open(FIREWALL_FLAG, "w").close()
        return None
    code, _, err = run("pkexec", os.path.join(HERE, "lte-hotspot-firewall"), iface, modem_iface(), timeout=180)
    if code != 0:
        return "Firewall setup was cancelled or failed" + (f": {err}" if err else "")
    os.makedirs(STATE_DIR, exist_ok=True)
    open(FIREWALL_FLAG, "w").close()
    return None


def on():
    st = status()
    if not st["configured"]:
        return "Set the network name and password first"
    err = ensure_firewall(st["iface"])
    if err:
        return err
    # Make sure mobile data is up: the hotspot shares it.
    if not mobile_data_active():
        code, _, err = run(os.path.join(HERE, "lte-mode"), "data", timeout=240)
        if code != 0:
            return "Mobile data didn't come up" + (f": {err}" if err else "")
    code, _, err = run("nmcli", "--wait", "45", "connection", "up", "id", CONN, timeout=60)
    return None if code == 0 else (err or "Couldn't start the hotspot")


def off():
    code, _, err = run("nmcli", "connection", "down", "id", CONN)
    return None if code == 0 or "not an active connection" in err else err


def main(args):
    cmd = args[0] if args else "status"
    if cmd == "status":
        out(status())
    elif cmd == "defaults":
        out(defaults())
    elif cmd == "configure" and len(args) == 3:
        err = configure(args[1], args[2])
        out({"ok": err is None, "error": err or ""}, err is None)
    elif cmd in ("on", "off"):
        err = on() if cmd == "on" else off()
        out({"ok": err is None, "error": err or ""}, err is None)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
