#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Mobile data counter.

  lte-traffic          update and print {"rx", "tx", "total", "since"} as JSON
  lte-traffic reset    zero the counter
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lte_traffic  # noqa: E402

cmd = sys.argv[1] if len(sys.argv) > 1 else "show"
if cmd == "show":
    print(json.dumps(lte_traffic.update()))
elif cmd == "reset":
    print(json.dumps(lte_traffic.reset()))
else:
    sys.exit(__doc__)
