#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Three-state mobile control.
#
#   lte-mode off        modem off (NetworkManager WWAN radio off; remembered across reboots)
#   lte-mode network    registered on the network (SMS, USSD), no mobile data
#   lte-mode data       registered and connected
#   lte-mode heal       if the modem sits idle (not registered) while the radio is on,
#                       power-cycle it once so the protocol stack comes up again
#
# The GSM profile is passed in LTE_CONNECTION, or the first GSM profile is used.
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-lte"
HEAL_STAMP="$STATE_DIR/last-heal"
HEAL_INTERVAL=600   # seconds between automatic power cycles

conn="${LTE_CONNECTION:-$(nmcli -t -f NAME,TYPE connection show | awk -F: '$2=="gsm"{print $1; exit}')}"

registration() { mmcli -m any -J 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["modem"]["3gpp"]["registration-state"])
except Exception: print("")'; }

wait_registered() {  # wait_registered <seconds>
  local end=$((SECONDS + $1))
  while (( SECONDS < end )); do
    case "$(registration)" in home*|roaming*) return 0 ;; esac
    sleep 2
  done
  return 1
}

power_cycle() {
  mkdir -p "$STATE_DIR"; date +%s > "$HEAL_STAMP"
  mmcli -m any --disable >/dev/null 2>&1
  mmcli -m any --set-power-state-low >/dev/null 2>&1
  sleep 3
  mmcli -m any --enable >/dev/null 2>&1
}

data_down() {
  [[ -n $conn ]] || return 0
  nmcli connection modify id "$conn" connection.autoconnect no 2>/dev/null || echo "Couldn't save the autoconnect setting" >&2
  nmcli connection down id "$conn" >/dev/null 2>&1 || true
}

case "${1:-}" in
  off)
    data_down
    nmcli radio wwan off
    ;;
  network)
    nmcli radio wwan on
    data_down
    # The modem sometimes stays idle after enabling (the stack isn't up yet).
    wait_registered 45 || { power_cycle; wait_registered 60 || echo "Modem isn't registered (no network?)" >&2; }
    ;;
  data)
    nmcli radio wwan on
    [[ -n $conn ]] || { echo "No GSM connection profile" >&2; exit 1; }
    wait_registered 45 || power_cycle
    nmcli connection modify id "$conn" connection.autoconnect yes 2>/dev/null || echo "Couldn't save the autoconnect setting" >&2
    nmcli --wait 90 connection up id "$conn"
    ;;
  heal)
    [[ $(nmcli radio wwan) == enabled ]] || exit 0
    case "$(registration)" in home*|roaming*|"") exit 0 ;; esac
    last=$(cat "$HEAL_STAMP" 2>/dev/null || echo 0)
    (( $(date +%s) - last < HEAL_INTERVAL )) && exit 0
    power_cycle
    ;;
  *) echo "usage: lte-mode off|network|data|heal" >&2; exit 2 ;;
esac
